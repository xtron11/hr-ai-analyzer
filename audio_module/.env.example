# ═══════════════════════════════════════════════════════════
#  INTERVIEW PLATFORM — Environment Configuration
# ═══════════════════════════════════════════════════════════
#  Скопируй этот файл как .env и заполни значения
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── MongoDB (результаты ML-анализа) ──────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=interview_platform

# ── Supabase / PostgreSQL (workflow данные) ───────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── Redis (кэширование) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# ── RabbitMQ (очереди задач) ──────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AUDIO_QUEUE_NAME=audio_analysis_queue
WORKER_PREFETCH_COUNT=1

# ── Object Storage ────────────────────────────────────────
# Провайдер: local_dev | s3 | minio
STORAGE_PROVIDER=local_dev
STORAGE_BASE_PATH=./storage

# S3 / MinIO (заполнить если STORAGE_PROVIDER != local_dev)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=interview-files
S3_REGION=us-east-1
